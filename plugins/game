// plugins/game.js - META AI MD GAME BY SIMON TECH
const axios = require('axios');

const MENU_PFP = "https://i.postimg.cc/GmSz8cDT/IMG-20261105-WA0073.jpg";

// Game memory - per chat
let games = {}; // { chatId: { type, answer, tries, score, player } }
let scores = {}; // { userId: points }

function addScore(user, pts) {
  scores[user] = (scores[user] || 0) + pts;
  return scores[user];
}

function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

const TRIVIA = [
  { q: "Wetin be capital of Nigeria?", a: "Abuja", opt: "A) Lagos  B) Abuja  C) Kano" },
  { q: "How many states Nigeria get?", a: "36", opt: "A) 30  B) 36  C) 40" },
  { q: "Who sing 'Lonely'?", a: "Asake", opt: "A) Asake  B) Davido  C) Wizkid" },
  { q: "Wetin be 2 + 2 x 2?", a: "6", opt: "A) 8  B) 6  C) 4" },
  { q: "Which animal be king of jungle?", a: "Lion", opt: "A) Tiger  B) Lion  C) Elephant" },
  { q: "Wetin be largest ocean?", a: "Pacific", opt: "A) Atlantic  B) Pacific  C) Indian" },
  { q: "How many days make 1 week?", a: "7", opt: "A) 5  B) 6  C) 7" },
  { q: "Wetin be colour of Nigeria flag?", a: "Green White Green", opt: "A) Green White Green  B) Red White  C) Blue White" },
];

const RIDDLES = [
  { q: "What has keys but can't open locks?", a: "piano" },
  { q: "What gets wetter the more it dries?", a: "towel" },
  { q: "I speak without mouth, hear without ears. Who am I?", a: "echo" },
  { q: "What has face and two hands but no arms or legs?", a: "clock" },
  { q: "What can you catch but never throw?", a: "cold" },
  { q: "What has head and tail but no body?", a: "coin" },
];

const HANGMAN_WORDS = ["META", "SIMON", "NIGERIA", "LAGOS", "WHATSAPP", "FOOTBALL", "JOLLOF", "BANANA", "COMPUTER", "PYTHON"];

module.exports = async (sock, m, ctx) => {
  const { prefix, cmdName, args, q, reply, from, config } = ctx;
  const p = prefix;
  const sender = m.sender;
  const chat = from;

  // ============ SCORE / LEADERBOARD ============
  if (cmdName === 'score' || cmdName === 'myscore' || cmdName === 'leaderboard' || cmdName === 'top') {
    let my = scores[sender] || 0;
    let top = Object.entries(scores).sort((a,b) => b[1]-a[1]).slice(0,5);
    let topTxt = top.map(([u, s], i) => `${i+1}. @${u.split('@')[0]} - ${s} pts`).join('\n') || "No scores yet";
    return await reply(`> 🏆 𝙶𝙰𝙼𝙴 𝙻𝙴𝙰𝙳𝙴𝚁𝙱𝙾𝙰𝚁𝙳\n\n> 𝚈𝙾𝚄𝚁 𝚂𝙲𝙾𝚁𝙴 : ${my} pts\n\n> 𝚃𝙾𝙿 5 :\n${topTxt}\n\n> 𝙿𝙻𝙰𝚈 ${p}game 𝚃𝙾 𝙴𝙰𝚁𝙽 𝙿𝙾𝙸𝙽𝚃𝚂\n> 𝙼𝙴𝚃𝙰 𝙰𝙸 𝙼𝙳`, { mentions: top.map(([u]) => u) });
  }

  // ============ GAME MENU ============
  if (cmdName === 'game' || cmdName === 'games') {
    return await sock.sendMessage(from, { image: { url: MENU_PFP }, caption: `◈┈▉ \`ᴍᴇᴛᴀ ᴀɪ ᴍᴅ\` ▉┄◈\n\n> 🎮 𝙶𝙰𝙼𝙴 𝙼𝙴𝙽𝚄\n\n> ✦ ${p}guess - Guess number 1-10\n> ✦ ${p}quiz - Trivia quiz\n> ✦ ${p}riddle - Riddle game\n> ✦ ${p}rps - Rock Paper Scissors\n> ✦ ${p}dice - Roll dice\n> ✦ ${p}coinflip - Flip coin\n> ✦ ${p}slot - Slot machine 🎰\n> ✦ ${p}blackjack - Blackjack 21\n> ✦ ${p}tictactoe - Tic Tac Toe\n> ✦ ${p}hangman - Hangman word\n> ✦ ${p}mathgame - Math game\n> ✦ ${p}truth - Truth game\n> ✦ ${p}dare - Dare game\n> ✦ ${p}score - Your score\n\n> 🏆 𝚈𝙾𝚄𝚁 𝚂𝙲𝙾𝚁𝙴 : ${scores[sender] || 0} pts\n> 𝙼𝙴𝚃𝙰 𝙰𝙸 𝙼𝙳 𝙱𝚈 𝚂𝙸𝙼𝙾𝙽 𝚃𝙴𝙲𝙷` }, { quoted: m });
  }

  // ============ GUESS NUMBER ============
  if (cmdName === 'guess') {
    if (!games[chat] || games[chat].type !== 'guess') {
      // Start new game
      games[chat] = { type: 'guess', answer: Math.floor(Math.random()*10)+1, tries: 0, player: sender };
      if (!q) return await reply(`> 🎯 𝙶𝚄𝙴𝚂𝚂 𝙶𝙰𝙼𝙴 𝚂𝚃𝙰𝚁𝚃𝙴𝙳!\n\n> 𝙸 𝙳𝙾𝙽 𝙿𝙸𝙲𝙺 𝙽𝚄𝙼𝙱𝙴𝚁 1-10\n> 𝙶𝚄𝙴𝚂𝚂 𝙰𝙼 : ${p}guess 5\n> 𝙼𝙴𝚃𝙰 𝙰𝙸 𝙼𝙳`);
    }
    let g = games[chat];
    let num = parseInt(q);
    if (isNaN(num)) return await reply(`> 𝙶𝚄𝙴𝚂𝚂 𝙰 𝙽𝚄𝙼𝙱𝙴𝚁 : ${p}guess 5`);
    g.tries++;
    if (num === g.answer) {
      let pts = g.tries === 1 ? 20 : 10;
      let total = addScore(sender, pts);
      delete games[chat];
      return await reply(`> 🎉 𝚈𝙾𝚄 𝚆𝙸𝙽!\n\n> 𝙸𝚃 𝚆𝙰𝚂 ${g.answer}\n> 𝚃𝚁𝙸𝙴𝚂 : ${g.tries}\n> +${pts} 𝙿𝚃𝚂\n> 𝚈𝙾𝚄𝚁 𝚃𝙾𝚃𝙰𝙻 : ${total} pts\n> 𝙼𝙴𝚃𝙰 𝙰𝙸 𝙼𝙳`);
    }
    return await reply(`> ❌ 𝚆𝚁𝙾𝙽𝙶! ${num} ${num < g.answer ? 'too small 👇' : 'too big 👆'}\n> 𝚃𝚁𝚈 𝙰𝙶𝙰𝙸𝙽 : ${p}guess <number>\n> 𝚃𝚁𝙸𝙴𝚂 : ${g.tries}`);
  }

  // ============ QUIZ ============
  if (cmdName === 'quiz') {
    if (!q) {
      let quiz = pick(TRIVIA);
      games[chat] = { type: 'quiz', answer: quiz.a.toLowerCase(), q: quiz.q, player: sender };
      return await reply(`> ❓ 𝚀𝚄𝙸𝚉 𝙶𝙰𝙼𝙴\n\n> ${quiz.q}\n\n> ${quiz.opt}\n\n> 𝙰𝙽𝚂𝚆𝙴𝚁 𝚆𝙸𝚃𝙷 : ${p}quiz <your answer>\n> 𝙴𝚇𝙰𝙼𝙿𝙻𝙴 : ${p}quiz Abuja\n> 𝙼𝙴𝚃𝙰 𝙰𝙸 𝙼𝙳`);
    }
    let g = games[chat];
    if (!g || g.type !== 'quiz') return await reply(`> 𝚂𝚃𝙰𝚁𝚃 𝙵𝙸𝚁𝚂𝚃 : ${p}quiz`);
    if (q.toLowerCase().includes(g.answer) || g.answer.includes(q.toLowerCase())) {
      let total = addScore(sender, 15);
      delete games[chat];
      return await reply(`> 🎉 𝙲𝙾𝚁𝚁𝙴𝙲𝚃!\n\n> 𝙰𝙽𝚂𝚆𝙴𝚁 𝙽𝙰 ${g.answer.toUpperCase()}\n> +15 𝙿𝚃𝚂\n> 𝚈𝙾𝚄𝚁 𝚃𝙾𝚃𝙰𝙻 : ${total} pts\n> 𝙿𝙻𝙰𝚈 𝙰𝙶𝙰𝙸𝙽 : ${p}quiz`);
    }
    return await reply(`> ❌ 𝚆𝚁𝙾𝙽𝙶! 𝚃𝚁𝚈 𝙰𝙶𝙰𝙸𝙽\n> 𝚀𝚄𝙴𝚂𝚃𝙸𝙾𝙽 : ${g.q}\n> 𝙷𝙸𝙽𝚃 : 𝙸𝚃 𝚂𝚃𝙰𝚁𝚃𝚂 𝚆𝙸𝚃𝙷 ${g.answer[0].toUpperCase()}`);
  }

  // ============ RIDDLE ============
  if (cmdName === 'riddle') {
    if (!q) {
      let r = pick(RIDDLES);
      games[chat] = { type: 'riddle', answer: r.a, q: r.q, player: sender };
      return await reply(`> 🧩 𝚁𝙸𝙳𝙳𝙻𝙴\n\n> ${r.q}\n\n> 𝙰𝙽𝚂𝚆𝙴𝚁 : ${p}riddle <answer>\n> 𝙼𝙴𝚃𝙰 𝙰𝙸 𝙼𝙳`);
    }
    let g = games[chat];
    if (!g || g.type !== 'riddle') return await reply(`> 𝚂𝚃𝙰𝚁𝚃 𝙵𝙸𝚁𝚂𝚃 : ${p}riddle`);
    if (q.toLowerCase().includes(g.answer)) {
      let total = addScore(sender, 15);
      delete games[chat];
      return await reply(`> 🎉 𝚈𝙾𝚄 𝙶𝙾𝚃 𝙰𝙼! 𝙸𝚃 𝙽𝙰 ${g.answer.toUpperCase()}\n> +15 𝙿𝚃𝚂 | 𝚃𝙾𝚃𝙰𝙻 : ${total} pts`);
    }
    return await reply(`> ❌ 𝙽𝙾𝙿𝙴! 𝚃𝚁𝚈 𝙰𝙶𝙰𝙸𝙽\n> 𝚁𝙸𝙳𝙳𝙻𝙴 : ${g.q}`);
  }
  if (cmdName === 'answer') {
    return await reply(`> ✅ 𝙰𝙽𝚂𝚆𝙴𝚁 𝚁𝙴𝙲𝙴𝙸𝚅𝙴𝙳\n> 𝚈𝙾𝚄𝚁 𝙰𝙽𝚂𝚆𝙴𝚁 : ${q || 'Empty'}\n> 𝙼𝙴𝚃𝙰 𝙰𝙸 𝙼𝙳 𝙶𝙾 𝙲𝙷𝙴𝙲𝙺 𝙰𝙼`);
  }

  // ============ RPS / DICE / COINFLIP ============
  if (cmdName === 'rps') {
    if (!q) return await reply(`> 𝙴𝚇𝙰𝙼𝙿𝙻𝙴 : ${p}rps rock\n> 𝙾𝙿𝚃𝙸𝙾𝙽𝚂 : rock | paper | scissors`);
    let choices = ['rock', 'paper', 'scissors'];
    let bot = pick(choices);
    let user = q.toLowerCase().trim();
    if (!choices.includes(user)) return await reply(`> 𝚄𝚂𝙴 rock / paper / scissors`);
    let win = (user === 'rock' && bot === 'scissors') || (user === 'paper' && bot === 'rock') || (user === 'scissors' && bot === 'paper');
    let draw = user === bot;
    if (win) addScore(sender, 10);
    return await reply(`> ✂️ 𝚁𝙾𝙲𝙺 𝙿𝙰𝙿𝙴𝚁 𝚂𝙲𝙸𝚂𝚂𝙾𝚁𝚂\n\n> 𝚈𝙾𝚄 : ${user}\n> 𝙱𝙾𝚃 : ${bot}\n> 𝚁𝙴𝚂𝚄𝙻𝚃 : ${draw ? 'DRAW 🤝' : win ? 'YOU WIN 🎉 +10 pts' : 'BOT WIN 😂'}\n> 𝚈𝙾𝚄𝚁 𝚂𝙲𝙾𝚁𝙴 : ${scores[sender] || 0} pts`);
  }
  if (cmdName === 'dice') {
    let n = Math.floor(Math.random()*6)+1;
    let n2 = Math.floor(Math.random()*6)+1;
    let total = addScore(sender, n === 6 ? 10 : 0);
    return await reply(`> 🎲 𝙳𝙸𝙲𝙴\n\n> 𝚈𝙾𝚄 𝚁𝙾𝙻𝙻 : ${n} + ${n2} = ${n+n2}\n> ${['','⚀','⚁','⚂','⚃','⚄','⚅'][n]} ${['','⚀','⚁','⚂','⚃','⚄','⚅'][n2]}\n> ${n === 6 || n2 === 6 ? '🎉 +10 PTS FOR 6!' : '𝙽𝙸𝙲𝙴 𝚁𝙾𝙻𝙻'}\n> 𝚂𝙲𝙾𝚁𝙴 : ${total} pts`);
  }
  if (cmdName === 'coinflip') {
    let res = Math.random() > 0.5 ? 'HEADS 🪙' : 'TAILS 🪙';
    let guess = q.toLowerCase();
    if (guess === 'heads' || guess === 'tails') {
      let win = guess === res.toLowerCase().split(' ')[0];
      if (win) addScore(sender, 10);
      return await reply(`> 🪙 𝙲𝙾𝙸𝙽𝙵𝙻𝙸𝙿\n\n> 𝚈𝙾𝚄 𝙶𝚄𝙴𝚂𝚂 : ${guess}\n> 𝚁𝙴𝚂𝚄𝙻𝚃 : ${res}\n> ${win ? '🎉 YOU WIN +10 pts!' : '❌ YOU LOSE'}\n> 𝚂𝙲𝙾𝚁𝙴 : ${scores[sender] || 0}`);
    }
    return await reply(`> 🪙 𝙲𝙾𝙸𝙽𝙵𝙻𝙸𝙿\n\n> 𝚁𝙴𝚂𝚄𝙻𝚃 : ${res}\n> 𝙶𝚄𝙴𝚂𝚂 𝙽𝙴𝚇𝚃 : ${p}coinflip heads`);
  }

  // ============ SLOT MACHINE ============
  if (cmdName === 'slot' || cmdName === 'slots') {
    let emojis = ['🍒','🍋','🔔','⭐','💎','7️⃣','🍇','🍊'];
    let s1 = pick(emojis), s2 = pick(emojis), s3 = pick(emojis);
    let win = s1 === s2 && s2 === s3;
    let jackpot = s1 === '💎' && s2 === '💎' && s3 === '💎';
    let pts = jackpot ? 100 : win ? 50 : 0;
    if (pts) addScore(sender, pts);
    return await reply(`> 🎰 𝚂𝙻𝙾𝚃 𝙼𝙰𝙲𝙷𝙸𝙽𝙴\n\n> | ${s1} | ${s2} | ${s3} |\n\n> ${jackpot ? '💎💎💎 JACKPOT! +100 PTS 🎉🎉' : win ? '🎉 YOU WIN! +50 PTS' : '❌ NO WIN, TRY AGAIN'}\n> 𝚂𝙲𝙾𝚁𝙴 : ${scores[sender] || 0} pts\n> 𝙼𝙴𝚃𝙰 𝙰𝙸 𝙼𝙳`);
  }

  // ============ BLACKJACK ============
  if (cmdName === 'blackjack' || cmdName === 'bj') {
    if (!games[chat] || games[chat].type !== 'blackjack') {
      let p1 = Math.floor(Math.random()*11)+1;
      let p2 = Math.floor(Math.random()*11)+1;
      let b1 = Math.floor(Math.random()*11)+1;
      games[chat] = { type: 'blackjack', playerTotal: p1+p2, botTotal: b1 + Math.floor(Math.random()*11)+1, player: sender };
      return await reply(`> 🃏 𝙱𝙻𝙰𝙲𝙺𝙹𝙰𝙲𝙺 - 21\n\n> 𝚈𝙾𝚄𝚁 𝙲𝙰𝚁𝙳𝚂 : ${p1} + ${p2} = ${p1+p2}\n> 𝙱𝙾𝚃 𝙲𝙰𝚁𝙳 : ${b1} + ?\n\n> ${p}hit - Take another card\n> ${p}stand - Stop\n> 𝙼𝙴𝚃𝙰 𝙰𝙸 𝙼𝙳`);
    }
    return await reply(`> 𝚈𝙾𝚄 𝙳𝙴𝚈 𝙶𝙰𝙼𝙴 𝙰𝙻𝚁𝙴𝙰𝙳𝚈\n> ${p}hit / ${p}stand`);
  }
  if (cmdName === 'hit') {
    let g = games[chat];
    if (!g || g.type !== 'blackjack') return await reply(`> 𝚂𝚃𝙰𝚁𝚃 𝙵𝙸𝚁𝚂𝚃 : ${p}blackjack`);
    let card = Math.floor(Math.random()*11)+1;
    g.playerTotal += card;
    if (g.playerTotal > 21) {
      delete games[chat];
      return await reply(`> 💥 𝙱𝚄𝚂𝚃! 𝚈𝙾𝚄 𝙳𝚁𝙰𝚆 ${card}\n> 𝚈𝙾𝚄𝚁 𝚃𝙾𝚃𝙰𝙻 : ${g.playerTotal} > 21\n> ❌ 𝙱𝙾𝚃 𝚆𝙸𝙽`);
    }
    if (g.playerTotal === 21) {
      let total = addScore(sender, 30);
      delete games[chat];
      return await reply(`> 🎉 𝙱𝙻𝙰𝙲𝙺𝙹𝙰𝙲𝙺! 21! 🎉\n> +30 𝙿𝚃𝚂 | 𝚃𝙾𝚃𝙰𝙻 : ${total} pts`);
    }
    return await reply(`> 🃏 𝚈𝙾𝚄 𝙳𝚁𝙰𝚆 ${card}\n> 𝚈
